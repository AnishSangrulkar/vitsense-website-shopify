    "custom_liquid_AAfc49": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Witmin: The Guilt-Free Indulgence Revolution</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <!-- Chosen Palette: Artisanal Chocolate -->\n    <!-- Application Structure Plan: The SPA uses a narrative, single-page scrolling structure to mirror the persuasive flow of the source pitch deck. It guides the user on a journey: 1. Hero section to capture attention. 2. An interactive \"Problem\" section to highlight the issues with traditional chocolate. 3. The \"Solution\" section introducing Witmin's pure ingredients. 4. An interactive \"Benefits\" section allowing users to explore the functional advantages. 5. A clear \"Comparison\" section to summarize the value proposition. 6. A final CTA. This structure was chosen to tell a compelling brand story, encouraging discovery rather than just presenting facts, which is ideal for a brand pitch. -->\n    <!-- Visualization & Content Choices: The application focuses on interactive storytelling over data charts, as the source material is qualitative. Key choices include: [Problem Section -> Goal: Inform/Agitate -> Interactive Cards on hover -> Highlights negative ingredients -> Justification: More engaging than a static list.], [Benefits Section -> Goal: Inform/Engage -> Clickable Benefit Tabs -> Reveals specific vitamin benefits dynamically -> Justification: User-driven discovery is more memorable and impactful than passive reading.], [Comparison Section -> Goal: Compare -> Side-by-side table -> Reinforces value proposition directly -> Justification: Provides a clear, scannable summary for easy comprehension.]. No charts are used as there is no quantitative data in the source report. -->\n    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->\n    <style>\n        body {\n            font-family: 'Poppins', sans-serif;\n        }\n        .bg-cream { background-color: #FDFBF5; }\n        .bg-dark-chocolate { background-color: #3D2B1F; }\n        .text-dark-chocolate { color: #3D2B1F; }\n        .text-light-chocolate { color: #9B7B63; }\n        .border-light-chocolate { border-color: #9B7B63; }\n        .accent-caramel { background-color: #C68E17; }\n        .text-accent-caramel { color: #C68E17; }\n        .benefit-button.active {\n            background-color: #3D2B1F;\n            color: #FDFBF5;\n        }\n        .benefit-button {\n            transition: all 0.3s ease-in-out;\n        }\n        .fade-in {\n            animation: fadeIn 0.7s ease-in-out;\n        }\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .chart-container {\n             position: relative;\n             width: 100%;\n             max-width: 600px;\n             margin-left: auto;\n             margin-right: auto;\n             height: 300px;\n             max-height: 400px;\n        }\n        @media (min-width: 768px) {\n             .chart-container { height: 350px; }\n        }\n    </style>\n</head>\n<body class=\"bg-cream text-dark-chocolate\">\n\n    <main>\n        <section id=\"hero\" class=\"min-h-screen flex flex-col justify-center items-center text-center p-4\" style=\"background-image: url('https://placehold.co/1200x800/C68E17/3D2B1F?text=Witmin'); background-size: cover; background-position: center;\">\n            <div class=\"bg-cream bg-opacity-80 p-8 md:p-12 rounded-lg shadow-xl max-w-3xl\">\n                <h1 class=\"text-4xl md:text-6xl font-bold text-dark-chocolate mb-4\">The Chocolate You Love, Reinvented.</h1>\n                <p class=\"text-lg md:text-xl text-light-chocolate mb-8\">Indulgence without compromise. Purity without the guilt.</p>\n                <a href=\"#problem\" class=\"bg-dark-chocolate text-cream font-bold py-3 px-8 rounded-full text-lg hover:bg-light-chocolate transition duration-300\">Discover the Revolution</a>\n            </div>\n        </section>\n\n        <section id=\"problem\" class=\"py-20 px-4\">\n            <div class=\"max-w-4xl mx-auto text-center\">\n                <h2 class=\"text-3xl md:text-4xl font-bold mb-4\">The Unspoken Truth About Chocolate</h2>\n                <p class=\"text-lg text-light-chocolate mb-12 max-w-2xl mx-auto\">We all love it, yet we feel a pang of guilt. The heartbreaking truth is, the treat we adore has been compromised by ingredients that don't belong. This section reveals the hidden culprits in most conventional chocolate bars.</p>\n                <div class=\"grid md:grid-cols-3 gap-8\">\n                    <div class=\"border border-gray-200 p-8 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300\">\n                        <div class=\"text-4xl mb-4\">⛽</div>\n                        <h3 class=\"text-2xl font-semibold mb-2\">Vegetable Oils</h3>\n                        <p class=\"text-light-chocolate\">Often used as cheap fillers, they alter the texture and add unnecessary fats, masking the true flavor of cocoa.</p>\n                    </div>\n                    <div class=\"border border-gray-200 p-8 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300\">\n                        <div class=\"text-4xl mb-4\">🍬</div>\n                        <h3 class=\"text-2xl font-semibold mb-2\">Refined Sugars</h3>\n                        <p class=\"text-light-chocolate\">Mountains of calorie-dense, refined sugars create an unhealthy spike and overpower the delicate notes of real chocolate.</p>\n                    </div>\n                    <div class=\"border border-gray-200 p-8 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300\">\n                        <div class=\"text-4xl mb-4\">🧪</div>\n                        <h3 class=\"text-2xl font-semibold mb-2\">Artificial Preservatives</h3>\n                        <p class=\"text-light-chocolate\">A cocktail of chemicals designed for shelf life, not for your well-being. A moment of joy shouldn't have a list of regrets.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"solution\" class=\"py-20 px-4 bg-dark-chocolate text-cream\">\n            <div class=\"max-w-5xl mx-auto text-center\">\n                <h2 class=\"text-3xl md:text-4xl font-bold mb-4\">The Breakthrough: Welcome to Witmin</h2>\n                <p class=\"text-lg text-gray-300 mb-12 max-w-2xl mx-auto\">We asked, \"Why can't chocolate be real again?\" And then, we created the answer. Witmin is a return to integrity, crafting pure indulgence from ingredients you can trust and understand.</p>\n                <div class=\"grid md:grid-cols-3 gap-8 text-center\">\n                    <div class=\"p-6\">\n                        <div class=\"text-5xl mb-4\">🍫</div>\n                        <h3 class=\"text-2xl font-semibold mb-2\">Pure, Unadulterated Cocoa</h3>\n                        <p class=\"text-gray-400\">The rich, complex, beating heart of genuine chocolate. We use only high-quality cocoa beans for a flavor that's deep, authentic, and satisfying.</p>\n                    </div>\n                    <div class=\"p-6\">\n                       <div class=\"text-5xl mb-4\">🌿</div>\n                        <h3 class=\"text-2xl font-semibold mb-2\">Naturally Occurring Sugars</h3>\n                        <p class=\"text-gray-400\">Sweetness sourced from nature, providing a balanced flavor profile without the synthetic guilt trip or the unhealthy sugar crash.</p>\n                    </div>\n                    <div class=\"p-6\">\n                       <div class=\"text-5xl mb-4\">✨</div>\n                        <h3 class=\"text-2xl font-semibold mb-2\">Absolutely ZERO Preservatives</h3>\n                        <p class=\"text-gray-400\">Just the pristine goodness of real, fresh ingredients. Our chocolate is a pure expression of nature's finest offerings.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"benefits\" class=\"py-20 px-4\">\n            <div class=\"max-w-5xl mx-auto\">\n                <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold mb-4\">Beyond Delicious: Chocolate That Transforms You</h2>\n                    <p class=\"text-lg text-light-chocolate max-w-2xl mx-auto\">Witmin is more than guilt-free; it's a functional food that enhances your well-being. We've infused our bars with essential vitamins and minerals. Click below to explore how our chocolate gives back to your body.</p>\n                </div>\n                <div class=\"flex flex-col md:flex-row gap-8 items-center\">\n                    <div class=\"w-full md:w-1/3\">\n                        <div class=\"flex flex-col gap-4\">\n                            <button class=\"benefit-button text-lg w-full text-left font-semibold p-4 border border-gray-200 rounded-lg active\" data-benefit=\"bones\">\n                                🦴 Stronger Bones\n                            </button>\n                            <button class=\"benefit-button text-lg w-full text-left font-semibold p-4 border border-gray-200 rounded-lg\" data-benefit=\"brain\">\n                                🧠 Sharper Brain\n                            </button>\n                            <button class=\"benefit-button text-lg w-full text-left font-semibold p-4 border border-gray-200 rounded-lg\" data-benefit=\"immunity\">\n                                🛡️ Resilient Immunity\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"w-full md:w-2/3\">\n                        <div id=\"benefit-display\" class=\"bg-white p-8 rounded-lg shadow-lg min-h-[250px] flex flex-col justify-center fade-in\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"comparison\" class=\"py-20 px-4 bg-gray-100\">\n            <div class=\"max-w-4xl mx-auto\">\n                <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold mb-4\">A Clear Difference</h2>\n                    <p class=\"text-lg text-light-chocolate max-w-2xl mx-auto\">The choice is simple when you see it side-by-side. Here's how Witmin redefines what you should expect from your chocolate.</p>\n                </div>\n                <div class=\"overflow-x-auto\">\n                    <table class=\"w-full text-left border-collapse\">\n                        <thead>\n                            <tr>\n                                <th class=\"p-4 border-b-2 border-dark-chocolate text-xl font-bold\">Feature</th>\n                                <th class=\"p-4 border-b-2 border-dark-chocolate text-xl font-bold\">Typical Chocolate</th>\n                                <th class=\"p-4 border-b-2 border-dark-chocolate text-xl font-bold text-accent-caramel\">Witmin Chocolate</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <tr class=\"border-b border-gray-300\">\n                                <td class=\"p-4 font-semibold\">Core Ingredients</td>\n                                <td class=\"p-4 text-light-chocolate\">Cocoa powder, vegetable oils</td>\n                                <td class=\"p-4 font-medium\">Pure, unadulterated cocoa</td>\n                            </tr>\n                            <tr class=\"border-b border-gray-300\">\n                                <td class=\"p-4 font-semibold\">Sweetener</td>\n                                <td class=\"p-4 text-light-chocolate\">Refined white sugar</td>\n                                <td class=\"p-4 font-medium\">Naturally occurring sugars</td>\n                            </tr>\n                            <tr class=\"border-b border-gray-300\">\n                                <td class=\"p-4 font-semibold\">Additives</td>\n                                <td class=\"p-4 text-light-chocolate\">Artificial preservatives, fillers</td>\n                                <td class=\"p-4 font-medium\">ZERO preservatives or fillers</td>\n                            </tr>\n                            <tr class=\"border-b border-gray-300\">\n                                <td class=\"p-4 font-semibold\">Health Benefits</td>\n                                <td class=\"p-4 text-light-chocolate\">None, often detrimental</td>\n                                <td class=\"p-4 font-medium\">Rich in essential vitamins & minerals</td>\n                            </tr>\n                            <tr>\n                                <td class=\"p-4 font-semibold\">The Feeling</td>\n                                <td class=\"p-4 text-light-chocolate\">A moment of guilt</td>\n                                <td class=\"p-4 font-medium\">Pure, elevated indulgence</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"cta\" class=\"py-20 px-4 bg-dark-chocolate text-cream\">\n            <div class=\"max-w-3xl mx-auto text-center\">\n                <h2 class=\"text-3xl md:text-4xl font-bold mb-4\">So, What's the Catch?</h2>\n                <p class=\"text-xl text-gray-300 mb-8\">The only \"catch\" is the irresistible desire you'll feel for chocolate that's both profoundly delicious and actively good for you.</p>\n                <a href=\"#\" class=\"bg-cream text-dark-chocolate font-bold py-4 px-10 rounded-full text-xl hover:bg-gray-200 transition duration-300 shadow-lg\">Taste The Revolution</a>\n            </div>\n        </section>\n\n    </main>\n\n    <footer class=\"bg-cream p-6 text-center\">\n        <p class=\"text-light-chocolate\">&copy; 2025 Witmin Foods. Indulgence, Elevated.</p>\n    </footer>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const benefitButtons = document.querySelectorAll('.benefit-button');\n            const benefitDisplay = document.getElementById('benefit-display');\n\n            const benefitData = {\n                bones: {\n                    icon: '🦴',\n                    title: 'For Stronger Bones',\n                    text: 'Our chocolate is fortified with essential minerals like Calcium and Vitamin D, which work together to support bone density and strength. It\\'s a delightful square that helps support your active life.'\n                },\n                brain: {\n                    icon: '🧠',\n                    title: 'For a Sharper Brain',\n                    text: 'Infused with Omega-3 and B-vitamins, this decadent bite helps fuel focus, memory, and creativity. It\\'s the perfect treat to nourish your mind and power through your day.'\n                },\n                immunity: {\n                    icon: '🛡️',\n                    title: 'For Resilient Immunity',\n                    text: 'Packed with antioxidants, Vitamin C, and Zinc, our chocolate helps build your body\\'s natural defenses like an impenetrable shield, protecting you day in and day out.'\n                }\n            };\n\n            function updateBenefitDisplay(benefitKey) {\n                const data = benefitData[benefitKey];\n                if (!data) return;\n\n                benefitDisplay.innerHTML = `\n                    <div class=\"text-center md:text-left fade-in\">\n                        <div class=\"text-4xl mb-4\">${data.icon}</div>\n                        <h3 class=\"text-2xl font-bold mb-2\">${data.title}</h3>\n                        <p class=\"text-light-chocolate text-lg\">${data.text}</p>\n                    </div>\n                `;\n\n                benefitButtons.forEach(button => {\n                    button.classList.remove('active');\n                    if (button.dataset.benefit === benefitKey) {\n                        button.classList.add('active');\n                    }\n                });\n            }\n\n            benefitButtons.forEach(button => {\n                button.addEventListener('click', () => {\n                    const benefitKey = button.dataset.benefit;\n                    updateBenefitDisplay(benefitKey);\n                });\n            });\n            \n            updateBenefitDisplay('bones');\n\n            document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n                anchor.addEventListener('click', function (e) {\n                    e.preventDefault();\n                    document.querySelector(this.getAttribute('href')).scrollIntoView({\n                        behavior: 'smooth'\n                    });\n                });\n            });\n        });\n    </script>\n\n</body>\n</html>",
        "color_scheme": "",
