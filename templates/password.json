      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Witmin - Coming Soon!</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css\">\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.9.1/gsap.min.js\"></script>\n    <style>\n        /* Custom styles for the chocolate theme */\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #EDE8E1; /* Light beige background */\n            display: flex; /* Use flex to center content */\n            flex-direction: column; /* Stack content vertically */\n            justify-content: center; /* Center content vertically */\n            align-items: center; /* Center content horizontally */\n            min-height: 100vh; /* Ensure body takes full viewport height */\n            margin: 0;\n            color: #4A2C2A; /* Dark chocolate text for readability */\n            overflow-x: hidden; /* Prevent horizontal scroll on small screens */\n        }\n\n        .main-content-wrapper {\n            min-height: 100vh; /* Adjusted to fit content better */\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            padding: 20px; /* Add some padding around the wrapper */\n            box-sizing: border-box; /* Include padding in element's total width and height */\n        }\n        \n        /* LOGO STYLES */\n        .logo-container {\n            margin-bottom: 2rem;\n            max-width: 200px; /* Adjust max width as needed */\n            margin: 0 auto 2rem;\n        }\n\n        .logo-container img {\n            width: 100%;\n            height: auto;\n        }\n\n        .coming-soon-container {\n            background-color: #FDF9F3; /* Creamy beige card background */\n            border-radius: 1.5rem; /* Rounded corners */\n            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15); /* Slightly more prominent shadow */\n            padding: 3.5rem; /* Increased padding */\n            text-align: center;\n            max-width: 650px; /* Slightly wider for more content */\n            width: 90vw; /* Responsive width */\n            position: relative;\n            z-index: 2; /* Ensure content is above background elements */\n            animation: fadeInScale 1s ease-out forwards; /* Fade in animation */\n            margin-left: auto; /* Center the container */\n            margin-right: auto; /* Center the container */\n            \n            /* NEW: Add a subtle border for a more defined look */\n            border: 2px solid rgba(111, 78, 55, 0.2);\n        }\n\n        /* Animation for the main container */\n        @keyframes fadeInScale {\n            from {\n                opacity: 0;\n                transform: scale(0.9);\n            }\n            to {\n                opacity: 1;\n                transform: scale(1);\n            }\n        }\n\n        .highlight-text {\n            color: #6F4E37; /* Medium chocolate brown for highlights */\n            font-weight: 700;\n        }\n\n        /* Subtle background animation circles */\n        .background-circles {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            overflow: hidden;\n            z-index: 1;\n        }\n\n        .circle {\n            position: absolute;\n            border-radius: 50%;\n            background: rgba(111, 78, 55, 0.08); /* Transparent chocolate brown */\n            animation: moveCircles 15s infinite ease-in-out alternate;\n        }\n\n        .circle:nth-child(1) {\n            width: 150px;\n            height: 150px;\n            top: 10%;\n            left: 15%;\n            animation-delay: 0s;\n        }\n\n        .circle:nth-child(2) {\n            width: 100px;\n            height: 100px;\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 2s;\n            animation-duration: 18s;\n        }\n\n        .circle:nth-child(3) {\n            width: 200px;\n            height: 200px;\n            top: 50%;\n            left: -5%;\n            animation-delay: 4s;\n            animation-duration: 20s;\n        }\n\n        .circle:nth-child(4) {\n            width: 120px;\n            height: 120px;\n            bottom: -5%;\n            left: 30%;\n            animation-delay: 6s;\n            animation-duration: 16s;\n        }\n\n        .circle:nth-child(5) {\n            width: 180px;\n            height: 180px;\n            top: 5%;\n            right: 25%;\n            animation-delay: 1s;\n            animation-duration: 17s;\n        }\n\n        @keyframes moveCircles {\n            0% {\n                transform: translate(0, 0) scale(1);\n            }\n            50% {\n                transform: translate(30px, 30px) scale(1.1);\n            }\n            100% {\n                transform: translate(0, 0) scale(1);\n            }\n        }\n\n        /* --- 3D Treasure Chest Section --- */\n        .treasure-section {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            margin-top: 2.5rem;\n            margin-bottom: 2.5rem;\n            position: relative; /* For positioning dialogue over canvas */\n            width: 100%; /* Ensure it takes full available width */\n        }\n\n        #treasureCanvas {\n            width: 300px; /* Decreased width for the 3D canvas */\n            height: 240px; /* Decreased height for the 3D canvas */\n            display: block;\n            margin: 0 auto 1rem auto;\n            cursor: pointer;\n            border-radius: 1rem;\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);\n            max-width: 90%; /* Responsive sizing for canvas */\n            height: auto; /* Maintain aspect ratio */\n            \n            /* NEW: Add a border to the canvas as well */\n            border: 1px solid rgba(111, 78, 55, 0.1);\n        }\n\n        /* Dialogue styling for the treasure chest dialogue (dialogue2) */\n        .dialogue-text {\n            position: absolute;\n            font-size: 1.1rem;\n            font-weight: 600;\n            color: #4A2C2A;\n            background-color: rgba(255, 255, 255, 0.9);\n            padding: 0.75rem 1.25rem;\n            border-radius: 0.75rem;\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\n            opacity: 0;\n            transition: opacity 0.5s ease;\n            z-index: 10;\n            text-align: center;\n            min-width: 200px;\n            max-width: 80%; /* Adjusted for better mobile fit */\n            left: 50%;\n            transform: translateX(-50%);\n            bottom: 120px; /* Adjusted position to be higher relative to the canvas */\n            box-sizing: border-box; /* Include padding in element's total width and height */\n        }\n\n        .dialogue-text.show {\n            opacity: 1;\n        }\n\n        /* New style for the introductory dialogue (dialogue1) */\n        .intro-dialogue {\n            font-size: 1.1rem;\n            font-weight: 600;\n            color: #4A2C2A;\n            background-color: rgba(255, 255, 255, 0.9);\n            padding: 0.75rem 1.25rem;\n            border-radius: 0.75rem;\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\n            text-align: center;\n            margin: 1.5rem auto 0 auto;\n            max-width: 80%;\n            box-sizing: border-box; /* Include padding in