eens */\n        @media (max-width: 768px) {\n            .coming-soon-container {\n                padding: 2.5rem 1.5rem; /* Reduce padding on smaller screens */\n            }\n\n            h1 {\n                font-size: 3rem; /* Adjust heading size */\n            }\n\n            .witmin-dialogue {\n                font-size: 1.5rem; /* Adjust dialogue font size */\n            }\n\n            #treasureCanvas {\n                width: 250px; /* Further decrease canvas width */\n                height: 200px; /* Further decrease canvas height */\n            }\n\n            .dialogue-text {\n                bottom: 100px; /* Adjust dialogue position relative to smaller canvas */\n                font-size: 1rem;\n            }\n\n            .intro-dialogue {\n                font-size: 1rem;\n            }\n\n            .early-bird-discount {\n                font-size: 1rem;\n            }\n\n            .social-links {\n                gap: 1.2rem; /* Reduce gap between social icons */\n                margin-top: 2rem;\n            }\n            .social-link {\n                font-size: 1.8rem;\n            }\n\n            .email-input-group {\n                flex-direction: column;\n            }\n            .email-input-group input,\n            .email-input-group button {\n                width: 100%;\n                min-width: 0;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .coming-soon-container {\n                padding: 2rem 1rem; /* Even smaller padding on very small screens */\n            }\n\n            h1 {\n                font-size: 2.5rem;\n            }\n\n            p {\n                font-size: 0.95rem;\n            }\n\n            .witmin-dialogue {\n                font-size: 1.3rem;\n            }\n\n            #treasureCanvas {\n                width: 200px; /* Even smaller canvas */\n                height: 160px;\n            }\n\n            .dialogue-text {\n                bottom: 80px; /* Adjust dialogue position */\n                font-size: 0.9rem;\n            }\n\n            .intro-dialogue {\n                font-size: 0.9rem;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"background-circles\">\n        <div class=\"circle\"></div>\n        <div class=\"circle\"></div>\n        <div class=\"circle\"></div>\n        <div class=\"circle\"></div>\n        <div class=\"circle\"></div>\n    </div>\n\n    <div class=\"main-content-wrapper\">\n        <div class=\"coming-soon-container py-12\">\n            <div class=\"logo-container\">\n                <a href=\"/\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0635/0317/1702/files/Resized_Witmin_logo.webp?v=1753984427\" alt=\"Witmin Logo\">\n                </a>\n            </div>\n\n            <h1 class=\"text-4xl md:text-5xl font-bold mb-4\">\n                We're Almost <span class=\"highlight-text\">Ready!</span>\n            </h1>\n            <p class=\"text-lg md:text-xl text-gray-700 mb-6\">\n                Our chocolates are coming your way.\n            </p>\n            <p id=\"dialogue1\" class=\"intro-dialogue show\">chocolate sunke unhealthy samzi kya?</p>\n\n            <div class=\"treasure-section\">\n                <canvas id=\"treasureCanvas\"></canvas>\n                <div id=\"sparkleOverlay\" class=\"sparkle-overlay\"></div>\n                <p id=\"dialogue2\" class=\"dialogue-text\"></p>\n            </div>\n\n            <p class=\"text-md text-gray-600 mb-8\">\n                Chocolate isn’t supposed to be complicated. So we stripped away the junk, the jargon, and the guilt. What’s left is <strong>Witmin</strong>.\n            </p>\n\n            <div class=\"social-links\">\n                <a href=\"https://www.facebook.com/share/15orh3JeGP/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fab fa-facebook\"></i></a>\n                <a href=\"https://www.instagram.com/witmin_official?igsh=MXywanpscGpqZzVldg%3D%3D&utm_source=qr\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fab fa-instagram\"></i></a>\n            </div>\n            <p class=\"early-bird-discount\">Subscribe and get exclusive 10% early bird discount.</p>\n        </div>\n    </div>\n\n    <script>\n        // --- 3D Treasure Chest Logic ---\n        let dialogue1, dialogue2, sparkleOverlay;\n        let scene, camera, renderer;\n        let treasureBoxContainer;\n        let chestBase, chestLidGroup, chocolateBar;\n        let jewels = [];\n        let isChestFullyOpen = false;\n        let isAnimating = false;\n        let scrollTimeout;\n\n        // Materials for chocolate theme\n        const darkWoodMaterial = new THREE.MeshStandardMaterial({ color: 0x5C3317, roughness: 0.8, metalness: 0.1 });\n        const lightWoodMaterial = new THREE.MeshStandardMaterial({ color: 0x8B4513, roughness: 0.7, metalness: 0.1 });\n        const goldMaterial = new THREE.MeshStandardMaterial({ color: 0xFFD700, roughness: 0.3, metalness: 0.8 });\n        const chocolateMaterial = new THREE.MeshStandardMaterial({ color: 0x4A2C2A, roughness: 0.6, metalness: 0.1 });\n\n        // Gem materials\n        const gemRubyMaterial = new THREE.MeshStandardMaterial({ color: 0xE0115F, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.9 });\n        const gemEmeraldMaterial = new THREE.MeshStandardMaterial({ color: 0x50C878, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.9 });\n        const gemSapphireMaterial = new THREE.MeshStandardMaterial({ color: 0x0F52BA, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.9 });\n        const gemAmethystMaterial = new THREE.MeshStandardMaterial({ color: 0x9966CC, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.9 });\n        const gemGoldMaterial = new THREE.MeshStandardMaterial({ color: 0xFFD700, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.9 });\n\n        function init3D() {\n            const canvas = document.getElementById('treasureCanvas');\n            dialogue1 = document.getElementById('dialogue1');\n            dialogue2 = document.getElementById('dialogue2');\n            sparkleOverlay = document.getElementById('sparkleOverlay');\n\n            const width = canvas.clientWidth;\n            const height = canvas.clientHeight;\n\n            scene = new THREE.Scene();\n            scene.background = new THREE.Color(0xFDF9F3);\n\n            camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);\n            camera.position.set(0, 3, 7);\n\n            renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });\n            renderer.setSize(width, height);\n            renderer.setPixelRatio(window.devicePixelRatio);\n            renderer.shadowMap.enabled = true;\n\n            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);\n            scene.add(ambientLight);\n\n            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.5);\n            directionalLight.position.set(5, 10, 7);\n            directionalLight.castShadow = true;\n            directionalLight.shadow.mapSize.width = 1024;\n            directionalLight.shadow.mapSize.height = 1024;\n            directionalLight.shadow.camera.near = 0.5;\n            directionalLight.shadow.camera.far = 50;\n            scene.add(directionalLight);\n\n            const planeGeometry = new THREE.PlaneGeometry(20, 20);\n            const planeMaterial = new THREE.MeshStandardMaterial({ color: 0xEDE8E1, side: THREE.DoubleSide });\n            const plane = new THREE.Mesh(planeGeometry, planeMaterial);\n            plane.rotation.x = Math.PI / 2;\n            plane.position.y = -3;\n            plane.receiveShadow = true;\n            scene.add(plane);\n\n            treasureBoxContainer = new THREE.Group();\n            scene.add(treasureBoxContainer);\n\n            const baseBodyGeometry = new THREE.BoxGeometry(6, 3, 4);\n            chestBase = new THREE.Mesh(baseBodyGeometry, darkWoodMaterial);\n            chestBase.position.y = -1.5;\n            chestBase.castShadow = true;\n            chestBase.receiveShadow = true;\n            treasureBoxContainer.add(chestBase);\n\n            const cornerAccentGeometry = new THREE.BoxGeometry(0.4, 3.2, 0.4);\n            const goldAccentMaterial = new THREE.MeshStandardMaterial({ color: 0xFFD700, roughness: 0.3, metalness: 0.8 });\n\n            const acc1 = new THREE.Mesh(cornerAccentGeometry, goldAccentMaterial);\n            acc1.position.set(2.8, 0, 1.8);\n            chestBase.add(acc1);\n\n            const acc2 = new THREE.Mesh(cornerAccentGeometry, goldAccentMaterial);\n            acc2.position.set(-2.8, 0, 1.8);\n            chestBase.add(acc2);\n\n            const acc3 = new THREE.Mesh(cornerAccentGeometry, goldAccentMaterial);\n            acc3.position.set(2.8, 0, -1.8);\n            chestBase.add(acc3);\n\n            const acc4 = new THREE.Mesh(cornerAccentGeometry, goldAccentMaterial);\n            acc4.position.set(-2.8, 0, -1.8);\n            chestBase.add(acc4);\n\n            const innerVelvetGeometry = new THREE.BoxGeometry(5.6, 2.8, 3.8);\n            const redVelvetMaterial = new THREE.MeshStandardMaterial({ color: 0x8B0000, roughness: 0.5, metalness: 0.1 });\n            const innerVelvet = new THREE.Mesh(innerVelvetGeometry, redVelvetMaterial);\n            innerVelvet.position.y = 0;\n            chestBase.add(innerVelvet);\n\n            chestLidGroup = new THREE.Group();\n            chestLidGroup.position.set(0, 1.5, -2);\n            chestLidGroup.castShadow = true;\n            chestLidGroup.receiveShadow = true;\n            chestBase.add(chestLidGroup);\n\n            const lidGeometry = new THREE.BoxGeometry(6.2, 0.6, 4.2);\n            const lidMesh = new THREE.Mesh(lidGeometry, lightWoodMaterial);\n            lidMesh.position.set(0, 0.3, 2.1);\n            lidMesh.castShadow = true;\n            lidMesh.receiveShadow = true;\n            chestLidGroup.add(lidMesh);\n\n            const claspGeometry = new THREE.BoxGeometry(0.6, 0.6, 0.6);\n            const clasp = new THREE.Mesh(claspGeometry, goldMaterial);\n            clasp.position.set(0, 0.3, 2.1 + 1.9);\n            lidMesh.add(clasp);\n\n            const jewelGeometry = new THREE.IcosahedronGeometry(0.15);\n\n            const lidJewel1 = new THREE.Mesh(jewelGeometry, gemRubyMaterial);\n            lidJewel1.position.set(-2.5, 0.35, 2.1 + 1.2);\n            lidMesh.add(lidJewel1);\n            jewels.push(lidJewel1);\n\n            const lidJewel2 = new THREE.Mesh(jewelGeometry, gemEmeraldMaterial);\n            lidJewel2.position.set(2.5, 0.35, 2.1 + 1.2);\n            lidMesh.add(lidJewel2);\n            jewels.push(lidJewel2);\n\n            const lidJewel3 = new THREE.Mesh(jewelGeometry, gemSapphireMaterial);\n            lidJewel3.position.set(-2.5, 0.35, 2.1 - 1.2);\n            lidMesh.add(lidJewel3);\n            jewels.push(lidJewel3);\n\n            const lidJewel4 = new THREE.Mesh(jewelGeometry, gemAmethystMaterial);\n            lidJewel4.position.set(2.5, 0.35, 2.1 - 1.2);\n            lidMesh.add(lidJewel4);\n            jewels.push(lidJewel4);\n\n            const chocolateGeometry = new THREE.BoxGeometry(2.5, 0.6, 1.2);\n            chocolateBar = new THREE.Mesh(chocolateGeometry, chocolateMaterial);\n            chocolateBar.position.set(0, 0.2, 0);\n            chocolateBar.visible = false;\n            chestBase.add(chocolateBar);\n\n            const innerJewelGeometry = new THREE.IcosahedronGeometry(0.4);\n\n            const innerJewel1 = new THREE.Mesh(innerJewelGeometry, gemRubyMaterial);\n            innerJewel1.position.set(-1.2, 0.3, 0.3);\n            innerJewel1.visible = false;\n            chestBase.add(innerJewel1);\n            jewels.push(innerJewel1);\n\n            const innerJewel2 = new THREE.Mesh(innerJewelGeometry, gemEmeraldMaterial);\n            innerJewel2.position.set(1.2, 0.2, -0.6);\n            innerJewel2.visible = false;\n            chestBase.add(innerJewel2);\n            jewels.push(innerJewel2);\n\n            const innerJewel3 = new THREE.Mesh(innerJewelGeometry, gemGoldMaterial);\n            innerJewel3.position.set(0, 0.5, 1.0);\n            innerJewel3.visible = false;\n            chestBase.add(innerJewel3);\n            jewels.push(innerJewel3);\n\n            startChestAnimations();\n\n            window.addEventListener('resize', onWindowResize, false);\n            canvas.addEventListener('mouseenter', openAndMoveChest);\n            canvas.addEventListener('mouseleave', closeChest);\n            window.addEventListener('scroll', handleScroll);\n        }\n\n        function onWindowResize() {\n            const canvas = document.getElementById('treasureCanvas');\n            const width = canvas.clientWidth;\n            const height = canvas.clientHeight;\n            camera.aspect = width / height;\n            camera.updateProjectionMatrix();\n            renderer.setSize(width, height);\n        }\n\n        function animate() {\n            requestAnimationFrame(animate);\n            if (!isChestFullyOpen && !isAnimating && treasureBoxContainer) {\n                treasureBoxContainer.rotation.y = Math.sin(Date.now() * 0.001) * 0.05;\n            }\n\n            jewels.forEach(jewel => {\n                jewel.rotation.y += 0.02;\n                jewel.rotation.x += 0.01;\n            });\n\n            renderer.render(scene, camera);\n        }\n\n        function startChestAnimations() {\n            if (sparkleOverlay) sparkleOverlay.classList.add('sparkling');\n        }\n\n        async function openAndMoveChest() {\n            if (isAnimating || isChestFullyOpen) return;\n            isAnimating = true;\n\n            const mainTimeline = gsap.timeline();\n\n            mainTimeline\n                .to(chestLidGroup.rotation, {\n                    x: -Math.PI / 1.5,\n                    duration: 0.8,\n                    ease: \"power2.out\",\n                    onStart: () => {\n                        if (sparkleOverlay) sparkleOverlay.classList.remove('sparkling');\n                        jewels.forEach(jewel => {\n                            if (jewel.parent === chestBase && jewel.position.y > -1 && jewel.position.y < 1) {\n                                jewel.visible = true;\n                            }\n                        });\n                    }\n                })\n                .to(treasureBoxContainer.position, {\n                    x: -2,\n                    duration: 1.0,\n                    ease: \"power2.inOut\"\n                }, \"<0.2\")\n                .to(chocolateBar.position, {\n                    y: 1.5,\n                    duration: 0.6,\n                    ease: \"back.out(1.7)\",\n                    onStart: () => {\n                        if (chocolateBar) chocolateBar.visible = true;\n                    }\n                }, \"<0.5\")\n                .fromTo(dialogue2,\n                    { opacity: 0, y: 50 },\n                    { opacity: 1, y: 0, duration: 0.8, ease: \"power2.out\", onStart: () => {\n                        if (dialogue2) {\n                            dialogue2.innerHTML = `<span class=\"witmin-dialogue\">Witmin</span> hai mai!`;\n                            dialogue2.classList.add('show');\n                        }\n                    } }, \">\")\n                .call(() => {\n                    isChestFullyOpen = true;\n                    isAnimating = false;\n                });\n        }\n\n        function closeChest() {\n            if (!isChestFullyOpen || isAnimating) return;\n            isAnimating = true;\n            const tl = gsap.timeline();\n\n            tl.to(dialogue2, { opacity: 0, y: 20, duration: 0.4, ease: \"power1.in\", onComplete: () => {\n                if (dialogue2) {\n                    dialogue2.classList.remove('show');\n                    dialogue2.innerHTML = '';\n                }\n            } })\n              .to(chocolateBar.position, {\n                y: 0.2,\n                duration: 0.4,\n                ease: \"power1.in\",\n                onComplete: () => {\n                    if (chocolateBar) chocolateBar.visible = false;\n                    jewels.forEach(jewel => {\n                        if (jewel.parent === chestBase && jewel.position.y > -1 && jewel.position.y < 1) {\n                            jewel.visible = false;\n                        }\n                    });\n                }\n            }, \"<0.1\")\n            .to(treasureBoxContainer.position, {\n                x: 0,\n                duration: 1.0,\n                ease: \"power2.inOut\"\n            }, \"<0.2\")\n            .to(chestLidGroup.rotation, {\n                x: 0,\n                duration: 0.8,\n                ease: \"power2.out\",\n                onComplete: () => {\n                    isChestFullyOpen = false;\n                    isAnimating = false;\n                    if (sparkleOverlay) sparkleOverlay.classList.add('sparkling');\n                }\n            }, \"<0.2\");\n        }\n\n        function handleScroll() {\n            clearTimeout(scrollTimeout);\n            scrollTimeout = setTimeout(() => {\n                const canvas = document.getElementById('treasureCanvas');\n                if (!canvas) return;\n\n                const rect = canvas.getBoundingClientRect();\n                const viewportHeight = window.innerHeight;\n\n                // Define a \"visible\" threshold, e.g., at least 50% of the canvas is in view\n                const visibleThreshold = viewportHeight * 0.25; // 25% from top and 25% from bottom\n\n                const isCanvasVisible = (\n                    rect.top < viewportHeight - visibleThreshold &&\n                    rect.bottom > visibleThreshold\n                );\n\n                if (isCanvasVisible) {\n                    if (!isChestFullyOpen) {\n                        openAndMoveChest();\n                    }\n                } else {\n                    if (isChestFullyOpen) {\n                        closeChest();\n                    }\n                }\n            }, 100);\n        }\n\n        document.addEventListener('DOMContentLoaded', () => {\n            init3D();\n            animate();\n        });\n    </script>\n</body>\n</html>",
