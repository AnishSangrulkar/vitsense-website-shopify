<script>
  document.addEventListener('DOMContentLoaded', () => {
    const benefitButtons = document.querySelectorAll('.benefit-button');
    const benefitDisplay = document.getElementById('benefit-display');

    const benefitData = {
      bones: {
        icon: '🦴',
        title: 'For Stronger Bones',
        text: "Our chocolate is fortified with essential minerals like Calcium and Vitamin D, which work together to support bone density and strength. It's a delightful square that helps support your active life."
      },
      brain: {
        icon: '🧠',
        title: 'For a Sharper Brain',
        text: "Infused with Omega-3 and B-vitamins, this decadent bite helps fuel focus, memory, and creativity. It's the perfect treat to nourish your mind and power through your day."
      },
      immunity: {
        icon: '🛡️',
        title: 'For Resilient Immunity',
        text: "Packed with antioxidants, Vitamin C, and Zinc, our chocolate helps build your body's natural defenses like an impenetrable shield, protecting you day in and day out."
      }
    };

    function updateBenefitDisplay(benefitKey) {
      const data = benefitData[benefitKey];
      if (!data) return;
      benefitDisplay.innerHTML = `
        <div class="text-center md:text-left fade-in">
          <div class="text-4xl mb-4">${data.icon}</div>
          <h3 class="text-2xl font-bold mb-2">${data.title}</h3>
          <p class="text-light-chocolate text-lg">${data.text}</p>
        </div>
      `;
      benefitButtons.forEach(button => {
        button.classList.remove('active');
        if (button.dataset.benefit === benefitKey) button.classList.add('active');
      });
    }

    benefitButtons.forEach(button => {
      button.addEventListener('click', () => updateBenefitDisplay(button.dataset.benefit));
    });

    updateBenefitDisplay('bones');

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        document.querySelector(this.getAttribute('href')).scrollIntoView({ behavior: 'smooth' });
      });
    });
  });
</script>

